# NFC TimeSheets API — decision-1 (no Docker), decision-16 (everything on one VM).
# systemd, not PM2: already installed, survives reboot without a `pm2 startup` dance,
# journald rotates logs, adds zero runtime deps. See backlog/docs/runbook-vm-provisioning.md §5.
#
# Install: /etc/systemd/system/nfc-api.service

[Unit]
Description=NFC TimeSheets API (REST + AASA + /t + static admin)
Documentation=file:///srv/nfc/ops/README.md
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=simple
User=app
Group=app
WorkingDirectory=/srv/nfc
# 0640 root:app. REQUIRED: DATABASE_URL, APP_KEY, PORT. OPTIONAL: PUBLIC_DIR, PG_POOL_MAX,
# and SENTRY_DSN / SENTRY_ENVIRONMENT / SENTRY_RELEASE (decision-23).
# No ADMIN_PIN: decision-20 moved admin auth to email + password in the `admins` table, so
# there is no admin secret in the environment to leak into a unit file, a shell history or
# a log line. Never logged, never echoed.
#
# SENTRY_DSN absent is a SUPPORTED state, not a broken one: the SDK disables itself and the
# API boots and serves identically. It is not in the server's REQUIRED_ENV and must not be
# added there — telemetry must never be able to keep the API from starting.
EnvironmentFile=/etc/nfc/env
# --import is REQUIRED, not a style choice (server/package.json is "type": "module").
# `import "./instrument.mjs"` from inside server.js runs too late: pg and node:http are
# already loaded and never get instrumented. Dropping the flag silently loses all tracing.
ExecStart=/usr/bin/node --import /srv/nfc/instrument.mjs /srv/nfc/server.js
Restart=always
RestartSec=5

# PORT must be >=1024 (e.g. 8080) — User=app cannot bind privileged ports and the exe.dev
# proxy terminates TLS and forwards anyway. If you ever truly need :80, uncomment:
#AmbientCapabilities=CAP_NET_BIND_SERVICE
#CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# hardening — cheap, no downside for a plain Node service
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# ProtectSystem=strict makes the whole tree read-only; name the one path that is not.
# Sentry writes nothing to disk, so this needs no widening for it.
ReadWritePaths=/srv/nfc

[Install]
WantedBy=multi-user.target
