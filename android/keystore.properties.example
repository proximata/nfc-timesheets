# Copy to android/keystore.properties and fill in. THAT FILE IS GITIGNORED.
# Never commit it, never commit the .jks, never paste a password into branding.properties.
#
# Absent -> release builds fall back to the DEBUG signing config on purpose. The app then
# builds and runs from a fresh clone with no operator secret, and Play refuses the upload.
# That is the correct loud failure; a release build that silently ships debug-signed and
# gets rejected at 23:00 is not.
#
# CI/one-off alternative (same resolution, checked second):
#   TS_KEYSTORE_PATH  TS_KEYSTORE_PASSWORD  TS_KEY_ALIAS  TS_KEY_PASSWORD

storeFile=/absolute/path/to/upload-keystore.jks
storePassword=
keyAlias=upload
keyPassword=
