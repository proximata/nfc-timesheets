    <!-- ================================================================================
         NOCH NICHT ÜBERTRAGEN (TASK-225). Eine Schicht, die im Keller ohne Empfang
         gestempelt wurde, liegt auf dem Telefon, bis es wieder Internet hat. Das Telefon
         sendet sie inzwischen von selbst, auch bei geschlossener App — aber genau deshalb
         MUSS auf dem Bildschirm stehen, was noch offen ist. Eine wartende Schicht, die
         nur im Protokoll steht, ist derselbe Fehler an einer anderen Stelle: am Monatsende
         fehlt Geld auf dem Lohnzettel und niemand konnte vorher danach fragen.

         REGEL FÜR DIESE TEXTE: „wird gesendet" ist gelogen, solange kein Netz da ist.
         Es heißt „wartet", und es steht dabei, wann es zuletzt versucht wurde.
         ================================================================================ -->
    <string name="pending_heading">Noch nicht übertragen</string>
    <!-- %d = Anzahl der Schichten, die der Server noch nicht hat -->
    <plurals name="pending_count">
        <item quantity="one">%d Schicht liegt noch auf diesem Telefon</item>
        <item quantity="other">%d Schichten liegen noch auf diesem Telefon</item>
    </plurals>
    <string name="pending_body">Wird automatisch gesendet, sobald dieses Telefon wieder Internet hat – auch wenn die App geschlossen ist. Es geht nichts verloren.</string>
    <!-- %1$s = Datum und Uhrzeit des letzten Versuchs -->
