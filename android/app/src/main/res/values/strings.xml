    <!-- Disclosure trigger for signin_code_help + nfc_first_run_note (TASK-267): a
         one-way reveal, tapped by someone who wants the extra sentences, not shown by
         default. -->
    <string name="signin_more_info">Mehr Informationen</string>
    <string name="signin_submit">Anmelden</string>
    <string name="signin_submitting">Anmeldung läuft …</string>

