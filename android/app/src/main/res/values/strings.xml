<?xml version="1.0" encoding="utf-8"?>
<!--
  DEFAULT LOCALE = GERMAN (decision-8: the product's default language is German).

  values/ is the fallback Android uses when the phone's locale matches nothing else, so
  putting German here means a crew phone shows German no matter how it is configured.
  English lives in values-en/ as the source language. android/checks/core-check.kt
  asserts the two files have identical key sets and that every ApiFailure.messageKey
  resolves to a real string.

  Vocabulary is taken from web/messages/de.json so one worker who also sees the admin
  panel reads the same words: Objekt (building/location), Kunde (client),
  Schicht (shift), Mitarbeiter (worker), eingestempelt.

  app_name is NOT here: it comes from branding.properties via resValue(). Defining it in
  both places is a duplicate-resource build failure.
-->
<resources>

    <!-- Launch / session -->
    <string name="loading_session">Anmeldung wird geprüft …</string>

    <!-- Anmeldung mit Anmeldecode (decision-26). Der Code wird der Person am Telefon
         vorgelesen, gilt eine Stunde und genau einmal. Kein Grund für eine Ablehnung
         wird genannt – der Server unterscheidet falsch / abgelaufen / schon benutzt
         bewusst nicht, und diese Texte dürfen es auch nicht. -->
