    <plurals name="pending_blocked">
        <item quantity="one">%d Schicht kann nicht gesendet werden und braucht Ihre Verwaltung.</item>
        <item quantity="other">%d Schichten können nicht gesendet werden und brauchen Ihre Verwaltung.</item>
