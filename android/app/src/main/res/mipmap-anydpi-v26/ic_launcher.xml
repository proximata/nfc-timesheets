<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon only. minSdk is 26, which is exactly where adaptive icons landed, so no
  density-bucket PNGs are needed and none are committed — a placeholder binary is a thing
  nobody remembers to replace.

  ponytail: a plain NFC wave mark. CEILING: it is not a brand. The operator replaces
  ic_launcher_foreground.xml (and this file, if they want a raster) as part of
  white-labelling; nothing in the code refers to either.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
