# Signing material. NOTHING here may ever be committed: a keystore + its password is
# the operator's whole Play identity, and the SHA-256 of that cert is what
# assetlinks.json publishes. Losing it means a new app listing.
keystore.properties
*.jks
*.keystore

# Machine-local SDK path
local.properties

# Build output
.gradle/
build/
app/build/
captures/
.cxx/

# Signed APKs staged for sideloading. A binary, not a source artifact: it is rebuilt from
# a tagged commit, and a 1.6 MB blob in git history cannot be un-pushed later.
dist/

# Google services config, if push is ever added (decision: not in the first pass)
app/google-services.json

# Check runner scratch: third-party jars fetched on demand, never vendored
checks/.lib/
checks/.out/
# The android.nfc stubs compile here, deliberately apart from checks/.out: stub classes
# named android.nfc.* must never share a classpath with anything else.
checks/.out-nfc/
# Same again, for the operator-401 check: it compiles android.content stubs and net/Api.kt.
checks/.out-net/
# Same, for checks/live-flow.sh, which compiles the DEBUG source set in as well.
checks/.out-live/
checks/.live-out/

# Android Studio per-user state
.idea/
*.iml
