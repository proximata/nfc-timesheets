            "value" : "Vorerst überspringen"
          }
        }
      }
    },
    "Some older requests on this phone couldn't be read. Anything already sent is safe on the server." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige ältere Anfragen auf diesem Telefon konnten nicht gelesen werden. Alles bereits Gesendete liegt sicher am Server."
          }
        }
      }
    },
    "Somebody already gave this zone a building." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jemand hat dieser Zone bereits ein Objekt gegeben."
          }
        }
      }
    },
    "Somebody already made this card into a zone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jemand hat aus dieser Karte bereits eine Zone gemacht."
          }
        }
      }
    },
    "Something wrong? Ask what to do — hours, locations and payroll are managed by your admin on the web. You can still request material and sign out from the tabs below." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwas stimmt nicht? Fragen Sie Ihre Verwaltung – Stunden, Objekte und Abrechnung werden im Web verwaltet. Material anfordern und Abmelden erreichen Sie weiterhin über die Reiter unten."
          }
        }
      }
    },
    "Start with 0 or +43, for example 0664 1234567." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit 0 oder +43 beginnen, zum Beispiel 0664 1234567."
          }
        }
      }
    },
    "Started" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begonnen"
          }
        }
      }
    },
    "Started %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begonnen um %@"
          }
        }
      }
    },
    "Still clocked in" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch eingestempelt"
          }
        }
      }
