          }
        }
      }
    },
    "Your name is no longer on the roster. Ask your admin.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Name steht nicht mehr auf der Liste. Bitte bei Ihrer Verwaltung nachfragen."
