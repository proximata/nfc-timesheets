        }
      }
    },
    "Written and checked." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geschrieben und geprüft."
          }
        }
      }
    },
    "Written: %@ — %lld of %lld bytes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geschrieben: %1$@ — %2$lld von %3$lld Byte."
          }
        }
      }
    },
    "You were signed out. Sign in again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie wurden abgemeldet. Bitte melden Sie sich erneut an."
          }
        }
      }
    },
    "Your name is no longer on the roster. Ask your admin." : {
      "localizations" : {
        "de" : {
