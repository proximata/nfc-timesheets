            "state" : "translated",
            "value" : "Tag beschreiben"
          }
        }
      }
    },
    "Write it in your own words, for example: two mops and a large bottle of glass cleaner" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreiben Sie es in Ihren eigenen Worten, zum Beispiel: zwei Mopps und eine große Flasche Glasreiniger"
