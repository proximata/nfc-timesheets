            "value" : "Ihr Name steht nicht mehr auf der Liste. Bitte bei Ihrer Verwaltung nachfragen."
          }
        }
      }
    },
    "Your requests" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Anfragen"
          }
        }
      }
    },
    "Your shift at %@ hit 8 hours and was closed automatically. Open the app and confirm when you actually finished, or it will not be paid." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Schicht bei %@ hat 8 Stunden erreicht und wurde automatisch beendet. Öffnen Sie die App und bestätigen Sie, wann Sie tatsächlich fertig waren – sonst wird sie nicht bezahlt."
          }
        }
      }
    },
    "Zone created: %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zone erstellt: %@."
          }
        }
      }
    },
    "Zone created: %@. No building yet - bind it in Test a tag." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
