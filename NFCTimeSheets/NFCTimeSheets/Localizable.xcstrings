        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Woche"
          }
        }
      }
    },
    "This zone has no building yet, so a tap on its card resolves to nothing. Pick its building first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
