    "Unknown location": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unbekanntes Objekt"
          }
        }
      }
    },
    "We checked your old records": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben Ihre alten Einträge geprüft"
