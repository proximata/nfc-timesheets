      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas anfordern"
          }
        }
      }
    },
    "At the warehouse": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Lager eingetroffen"
          }
        }
      }
    },
    "Checking your sign-in": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldung wird geprüft"
          }
        }
      }
    },
    "Clocked in": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingestempelt"
          }
        }
      }
    },
    "Code not accepted. Check it and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Code nicht akzeptiert. Bitte prüfen und erneut versuchen."
          }
        }
      }
    },
    "Confirm finish times": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Endzeiten bestätigen"
          }
        }
      }
    },
    "Dismiss": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausblenden"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fertig"
          }
        }
      }
    },
    "Finish time is before the start time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Endzeit liegt vor der Startzeit."
          }
        }
      }
    },
    "Finished": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beendet"
          }
        }
      }
    },
    "Finished your open shift at %@ and started at %@. Confirm when you actually left %@ — it will not count until you do.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finished your open shift at %1$@ and started at %2$@. Confirm when you actually left %3$@ — it will not count until you do."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre offene Schicht bei %1$@ wurde beendet und bei %2$@ wurde eine neue begonnen. Bitte bestätigen Sie, wann Sie %3$@ wirklich verlassen haben – bis dahin zählt die Schicht nicht."
          }
        }
      }
    },
    "For %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für %@"
          }
        }
      }
    },
    "For staff who mount and test NFC tags. This never opens a shift.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Personal, das NFC-Tags montiert und testet. Dabei wird nie eine Schicht gestartet."
          }
        }
      }
    },
    "For the building you're in now": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für das Objekt, in dem Sie gerade sind"
          }
        }
      }
    },
    "Got it": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verstanden"
          }
        }
      }
    },
    "History": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlauf"
          }
        }
      }
    },
    "Hold your phone to the tag again to finish.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie Ihr Telefon erneut an den Tag, um zu beenden."
          }
        }
      }
    },
    "Hold your phone to the tag by the entrance to start.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie Ihr Telefon an den Tag beim Eingang, um zu beginnen."
          }
        }
      }
    },
    "Hours, locations and payroll are managed by your admin on the web.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stunden, Objekte und Abrechnung werden von Ihrer Verwaltung im Web verwaltet."
          }
        }
      }
    },
    "Later": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
