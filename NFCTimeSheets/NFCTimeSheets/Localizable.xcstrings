        }
      }
    },
    "What do you need?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was brauchen Sie?"
          }
        }
      }
    },
    "Write it in your own words, for example: two mops and a large bottle of glass cleaner": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreiben Sie es in Ihren eigenen Worten, zum Beispiel: zwei Mopps und eine große Flasche Glasreiniger"
          }
        }
      }
    },
    "You were signed out. Sign in again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie wurden abgemeldet. Bitte melden Sie sich erneut an."
