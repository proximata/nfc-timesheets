{
  "sourceLanguage": "en",
  "strings": {
    "%@ – %@  ·  %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ – %2$@  ·  %3$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ – %2$@  ·  %3$@"
          }
        }
      }
    },
    "%lld h at %@. Hold your phone to the tag to finish.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld h at %2$@. Hold your phone to the tag to finish."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld Std. bei %2$@. Halten Sie Ihr Telefon an den Tag, um zu beenden."
          }
        }
      }
    },
    "%lld of %lld characters": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld of %2$lld characters"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld von %2$lld Zeichen"
          }
        }
      }
    },
    "%lld of %lld confirmed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld of %2$lld confirmed"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld von %2$lld bestätigt"
          }
        }
      }
    },
    "%lld old shift%@ need your admin": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld old shift%2$@ need your admin"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld alte Schicht%2$@ braucht Ihre Verwaltung"
          }
        }
      }
    },
    "%lld unfinished shift(s) need a finish time": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld nicht abgeschlossene Schicht(en) brauchen eine Endzeit"
          }
        }
      }
    },
    "%lld unfinished shift(s) need a finish time before they can be paid.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld nicht abgeschlossene Schicht(en) brauchen eine Endzeit, bevor sie bezahlt werden können."
          }
        }
      }
    },
    "8:00:00+": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "8:00:00+"
          }
        }
      }
    },
    "Another shift is still running - finishing it first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine andere Schicht läuft noch – sie wird zuerst beendet."
          }
        }
      }
    },
    "App update": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App-Aktualisierung"
          }
        }
      }
    },
    "Apple sign-in failed. Try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldung mit Apple fehlgeschlagen. Bitte erneut versuchen."
          }
        }
      }
    },
    "Arrived %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingetroffen %@"
          }
        }
      }
    },
