        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Name"
          }
        }
      }
    },
    "No completed shifts yet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine abgeschlossenen Schichten."
          }
        }
      }
    },
    "No connection - try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Verbindung – bitte erneut versuchen."
          }
        }
      }
    },
    "No connection - will send when you're back online.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Verbindung – wird gesendet, sobald Sie wieder online sind."
          }
        }
      }
    },
    "No shifts yet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Schichten."
          }
        }
      }
    },
    "Not available on the server yet - saved and will be sent later.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am Server noch nicht verfügbar – gespeichert und wird später gesendet."
          }
        }
      }
    },
    "Note from the office: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmerkung der Verwaltung: %@"
          }
        }
      }
    },
    "Nothing asked for yet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts angefordert."
          }
        }
      }
    },
    "Nothing has been archived on this phone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Telefon wurde nichts archiviert."
          }
        }
      }
    },
    "Notifications are off, so this phone cannot remind you to clock out. Everything else still works.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigungen sind aus. Dieses Telefon kann Sie deshalb nicht daran erinnern, auszustempeln. Alles andere funktioniert weiter."
          }
        }
      }
    },
    "Open Settings": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen öffnen"
          }
        }
