<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sentry DSN for the iOS project. EMPTY = telemetry is off and the SDK is never
	     started; the app behaves exactly as it does with no Sentry at all.

	     Deliberately committed in cleartext, reasoned exactly like API.appKey in
	     API.swift: it is compiled into the binary, so `strings` on any installed IPA
	     recovers it, and hiding it from git would protect nothing while it sits readable
	     on every worker's phone. It is strictly WEAKER than the app key - it grants no
	     read and no write of company data; the worst case if extracted is junk events
	     burning Sentry quota, answered with inbound filters and rate limits.
	     Intentionally NOT in the psst vault, same reasoning as API.appKey.
	     Read in Telemetry.swift. This file is already wired via INFOPLIST_FILE, so
	     adding this key needs no project.pbxproj edit. -->
	<key>SentryDSN</key>
	<string></string>

	<!-- Universal-link host for the NFC tag URI, i.e. the operator's identity (see
	     ops/branding.json). Filled by Xcode from TS_TAG_HOST in NFCTimeSheets/Branding.xcconfig.

	     With that xcconfig NOT attached - which is the state this ships in - TS_TAG_HOST is an
	     undefined build setting and Xcode substitutes the EMPTY STRING here. Branding.swift
	     treats empty as unconfigured and falls back to "timesheets.exe.xyz", so this key
	     changes nothing until someone deliberately attaches the xcconfig.

	     NOT a secret and not a credential; it is on every tag in every stairwell.
	     This file is already wired via INFOPLIST_FILE, so adding this key needs no
	     project.pbxproj edit. -->
	<key>TSTagHost</key>
	<string>$(TS_TAG_HOST)</string>

	<!-- REST API host, i.e. where the app TALKS — never the same value as TSTagHost above once
	     a rebrand moves either one (decision-40). Filled by Xcode from TS_API_HOST in
	     NFCTimeSheets/Branding.xcconfig; same detached-by-default, no-op-until-attached shape
	     as TSTagHost. Read by API.swift via Branding.apiHost, which is the ONLY thing that
	     builds API.base — TagLink.host (the tag host) must never be used for that again. -->
	<key>TSApiHost</key>
	<string>$(TS_API_HOST)</string>

	<!-- Live Activities: the running shift on the Lock Screen and in the Dynamic Island,
	     with a timer the SYSTEM ticks. Apple requires this key in the APP target's
	     Info.plist; this file is already wired via INFOPLIST_FILE, so it needs no
	     project.pbxproj edit.

	     It is switched on ahead of the widget extension ON PURPOSE, and doing so is inert:
	     the extension is what RENDERS a Live Activity, so until the owner adds that target
	     (docs/LIVE-ACTIVITY-SETUP.md) Activity.request simply throws, LiveActivityController
	     swallows it, and the app behaves exactly as it did before. The alternative -
	     shipping the code and forgetting the key - is a build where the owner does all the
	     Xcode work and still sees nothing. -->
	<key>NSSupportsLiveActivities</key>
	<true/>

	<!-- THE MISSING KEY THAT CRASHED EVERY TAG-WRITE ATTEMPT (2026-08-24 field crash, iOS
	     14/26.5.2, symbolicated from Xcode Organizer's local crash cache under
	     ~/Library/Developer/Xcode/Products). CoreNFC does not politely refuse a reader
	     session started without this key - it calls its own
	     `__CRASHING_DUE_TO_PRIVACY_VIOLATION__` inside NFCHardwareManager and SIGABRTs the
	     whole process, on the XPC thread, the instant TagWriter.write()'s
	     NFCTagReaderSession.begin() reaches the system NFC daemon. The entitlement
	     (com.apple.developer.nfc.readersession.formats: TAG) says the app MAY use NFC;
	     this key is the separate, mandatory user-facing permission STRING Apple requires
	     before it will actually start a session - one without the other still crashes.
	     This file is already wired via INFOPLIST_FILE, so adding this key needs no
	     project.pbxproj edit. -->
	<key>NFCReaderUsageDescription</key>
	<string>Wird verwendet, um einen NFC-Tag am Objekt zu beschreiben oder zu prüfen.</string>
</dict>
</plist>
