{
  "name": "nfc-timesheets-web",
  "version": "0.1.0",
  "private": true,
  "description": "NFC TimeSheets admin panel. Static export, served by the Node API on the exe.dev VM.",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check.mjs",
    "verify": "pnpm check && pnpm lint && pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "@sentry/nextjs": "10.71.0",
    "next": "16.1.7",
    "next-intl": "4.12.0",
    "react": "19.1.9",
    "react-dom": "19.1.9"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/node": "22.20.1",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "typescript": "5.9.3"
  }
}
