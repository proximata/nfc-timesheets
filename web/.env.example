# Copy to .env.local for development. All of these are baked into the bundle at build time
# (NEXT_PUBLIC_*), so they are NOT secrets — no credential of any kind belongs in here.
# Admin sign-in is email + password against POST /admin/login (decision-20); the session is
# an httpOnly cookie the server sets, so the browser never holds a secret this app can read.

# Base URL of the REST API. Empty = same origin, which is what production uses: the Node API
# process serves this static export from the same host (decision-16).
# For `pnpm dev`, Next is on :3000 and the API is not, so point at it explicitly. The API must
# then send CORS `Access-Control-Allow-Credentials: true` + an explicit origin, because the
# session cookie is sent with `credentials: 'include'`.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Active locale, 'en' or 'de'. Production ships 'de' (decision-8) — the director works in
# German — and ops/deploy.sh passes it explicitly so a stale .env.local cannot ship English.
# Set 'en' here only if you want an English-first dev build. Either way the UI switcher works
# and a returning user's stored choice wins over this value.
NEXT_PUBLIC_DEFAULT_LOCALE=de

# Origin printed into the NFC tag URI shown on /locations/ (https://<host>/t?l=<uuid>).
# It MUST be the universal-link host from the app's Associated Domains and the AASA file
# (decision-4), never the host the admin panel happens to be open on — a tag written with the
# wrong origin does not open the app and can only be fixed by going back to the building.
# Leave unset in production; the default is the real host, and the source of truth for it is
# ops/branding.json (see ops/REBRAND.md). Setting this to anything other than that host is a
# development-only override — `node ops/check-branding.mjs` guards the default, not this file.
# NEXT_PUBLIC_TAG_BASE_URL=https://timesheets.exe.xyz

# Google Maps BROWSER key, for the Vienna map and the Street View thumbnails on
# /analytics/. NOT the same key as the server's GOOGLE_GEOCODING_KEY: this one is inlined
# into the bundle and readable by anyone who opens the panel, which is only safe because it
# is restricted BY HTTP REFERRER in the Google Cloud console. The server key is
# IP-restricted and must never appear here.
#
# LEAVE IT UNSET AND THE PANEL STILL WORKS: /analytics/ says "this build has no Google Maps
# key", draws no map, and the table under it carries every building and every number the map
# would have shown. That is the shipped default today, because ops/deploy.sh does not pass
# this variable — see web/README.md.
#
# The value lives in the psst vault: `psst get NEXT_PUBLIC_GOOGLE_MAPS_KEY` (from the repo
# ROOT; psst is directory-scoped and answers differently from a subdirectory).
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=AIza...
